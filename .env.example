# DriftGuard Environment Configuration (Secret-Free Example)

# Mock API Service
MOCK_API_HOST=127.0.0.1
MOCK_API_PORT=8001
MOCK_API_URL=http://127.0.0.1:8001

# Orchestrator Service
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_URL=http://127.0.0.1:8000

# Frontend Service
FRONTEND_PORT=5173
VITE_ORCHESTRATOR_URL=http://127.0.0.1:8000
VITE_MOCK_API_URL=http://127.0.0.1:8001

# Model Provider Configuration (Configurable single provider)
# Supported: gemini, openai, mock
ORCHESTRATOR_MODEL_PROVIDER=mock
ORCHESTRATOR_MODEL_NAME=gemini-3.5-flash-lite
# Set actual keys in local .env (never committed):
ORCHESTRATOR_MODEL_API_KEY=

# Persistence & Storage
SQLITE_DB_PATH=driftguard.sqlite3
LOG_LEVEL=INFO
